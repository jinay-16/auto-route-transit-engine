# ===================================================================
# AutoRoute Environment Variables Configuration
# Copy this file to .env or export the variables in your shell.
# ===================================================================

# Database Settings (MySQL)
DB_URL=jdbc:mysql://localhost:3306/autoroute_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# External Routing API (Google Maps Routes / Transit API)
# Optional: If left blank or invalid, AutoRoute runs transparently using the local Dijkstra dataset
GOOGLE_MAPS_API_KEY=
GOOGLE_TRANSIT_ENABLED=true

# AI Travel Assistant Configuration (Gemini / OpenAI compatible)
# Optional: If left blank, AutoRoute provides graceful offline rule-based travel assistance
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# CORS and Frontend Configuration
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080
PORT=8080
